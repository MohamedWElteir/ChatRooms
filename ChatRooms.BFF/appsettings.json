{
  "Keycloak": {
    "Authority": "https://keycloak:8080/realms/chatrooms",
    "ClientId": "chatrooms-bff"
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [
          { "RequestHeadersCopy": "true" },
          {
            "RequestHeader": "X-Forwarded-For",
            "Append": "{RemoteIpAddress}"
          }
        ]
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api": {
            "Address": "https+http://chatrooms-api"
          }
        }
      }
    }
  }
}