@page "/register"
@layout LandingLayout
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IRoomApiClient ApiClient
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Create account · ChatRooms</PageTitle>

<div class="auth-wrap">
    <div class="auth-card">

        <div class="auth-header">
            <p class="auth-brand">ChatRooms</p>
            <div class="auth-steps">
                <div class="auth-step @(Step >= 0 ? "active" : "") @(Step > 0 ? "done" : "")"></div>
                <div class="auth-step @(Step >= 1 ? "active" : "") @(Step > 1 ? "done" : "")"></div>
                <div class="auth-step @(Step >= 2 ? "active" : "")"></div>
            </div>
            <h1 class="auth-title">@StepTitles[Step]</h1>
            <p class="auth-sub">@StepSubs[Step]</p>
        </div>

        <div class="auth-body">
            @if (Step == 0)
            {
                <AppInput Label="Display name"
                          Placeholder="e.g. JaneDoe"
                          Value="@Name"
                          ValueChanged="@(v => { Name = v; })"
                          Hint="No spaces · max 15 characters"
                          ErrorMessage="@NameError" />

                <AppInput Label="Email address"
                          Type="email"
                          Placeholder="you@example.com"
                          Value="@Email"
                          ValueChanged="@(v => { Email = v; })"
                          ErrorMessage="@EmailError" />
            }
            else if (Step == 1)
            {
                <AppInput Label="Password"
                          Type="password"
                          Placeholder="Min. 8 characters"
                          Value="@Password"
                          ValueChanged="@(v => { Password = v; ValidatePassword(); })" />

                <div class="pw-strength">
                    <div class="pw-strength-bars">
                        @for (int i = 0; i < 4; i++)
                        {
                            var filled = i < PasswordScore;
                            var cls = filled ? $"pw-bar pw-bar--{PasswordClass}" : "pw-bar";
                            <div class="@cls"></div>
                        }
                    </div>
                    <span class="pw-strength-label">@PasswordLabel</span>
                </div>

                <AppInput Label="Confirm password"
                          Type="password"
                          Placeholder="Repeat your password"
                          Value="@PasswordConfirm"
                          ValueChanged="@(v => { PasswordConfirm = v; })"
                          ErrorMessage="@PasswordError" />
            }
            else if (Step == 2)
            {
                <div class="app-field">
                    <label class="app-field__label">Gender</label>
                    <div class="gender-grid">
                        <button class="gender-opt @(Gender == "Male" ? "gender-opt--selected" : "")"
                                type="button" @onclick="@(() => Gender = "Male")">
                            Male
                        </button>
                        <button class="gender-opt @(Gender == "Female" ? "gender-opt--selected" : "")"
                                type="button" @onclick="@(() => Gender = "Female")">
                            Female
                        </button>
                    </div>
                </div>

                <AppInput Label="Date of birth"
                          Type="date"
                          Value="@BirthDate"
                          ValueChanged="@(v => { BirthDate = v; })"
                          Hint="You must be at least 13 years old" />
            }

            @if (!string.IsNullOrEmpty(ServerError))
            {
                <div class="auth-error">@ServerError</div>
            }
        </div>

        <div class="auth-footer">
            <AppButton Variant="primary"
                       FullWidth="true"
                       Loading="@IsLoading"
                       Disabled="@(!IsStepValid())"
                       OnClick="HandleNext">
                @(Step == 2 ? "Create account" : "Continue")
            </AppButton>

            @if (Step > 0)
            {
                <AppButton Variant="secondary"
                           FullWidth="true"
                           OnClick="@(() => Step--)">
                    Back
                </AppButton>
            }

            <p class="auth-signin-link">
                Already have an account?
                <a href="#" @onclick="@(() => Nav.NavigateTo($"{BffUrl}/bff/login", forceLoad: true))"
                   @onclick:preventDefault="false">Sign in</a>
            </p>
        </div>

    </div>
</div>

@code {
    private int Step = 0;

    private string Name = "";
    private string Email = "";
    private string Password = "";
    private string PasswordConfirm = "";
    private string Gender = "";
    private string BirthDate = "";

    private string NameError = "";
    private string EmailError = "";
    private string PasswordError = "";
    private string ServerError = "";

    private int PasswordScore = 0;
    private string PasswordClass = "";
    private string PasswordLabel = "Enter a password";

    private bool IsLoading = false;

    private string BffUrl => Config["BffUrl"] ?? "http://localhost:5031";

    private string[] StepTitles = ["Create your account", "Secure your account", "A bit about you"];
    private string[] StepSubs =
    [
        "Start with your name and email.",
        "Choose a strong password.",
        "Almost done — just a couple more details."
    ];
    private HttpClient Http => HttpClientFactory.CreateClient("bff");
    private bool IsStepValid() => Step switch
    {
        0 => Name.Length is >= 2 and <= 15
             && !Name.Contains(' ')
             && Email.Contains('@') && Email.Contains('.'),

        1 => Password.Length >= 8
             && Password == PasswordConfirm
             && PasswordScore >= 2,

        2 => !string.IsNullOrEmpty(Gender)
             && !string.IsNullOrEmpty(BirthDate)
             && DateTime.TryParse(BirthDate, out var dob)
             && (DateTime.UtcNow.Year - dob.Year) >= 13,

        _ => false
    };

    private void ValidatePassword()
    {
        var p = Password;
        var score = 0;
        if (p.Length >= 8) score++;
        if (p.Any(char.IsUpper) && p.Any(char.IsLower)) score++;
        if (p.Any(char.IsDigit)) score++;
        if (p.Any(c => !char.IsLetterOrDigit(c))) score++;

        PasswordScore = score;
        (PasswordClass, PasswordLabel) = score switch
        {
            1 => ("weak", "Weak"),
            2 => ("fair", "Fair"),
            3 => ("good", "Good"),
            4 => ("strong", "Strong"),
            _ => ("", "Enter a password")
        };
    }

    private async Task HandleNext()
    {
        if (Step < 2) { Step++; return; }

        IsLoading = true;
        ServerError = "";

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"{BffUrl}/bff/register",
                new
                {
                    Name,
                    Email,
                    Password,
                    Gender,
                    BirthDate = DateTime.Parse(BirthDate)
                });

            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo($"{BffUrl}/bff/login", forceLoad: true);
            }
            else
            {
                var problem = await response.Content
                    .ReadFromJsonAsync<ProblemDetails>();
                ServerError = problem?.Detail ?? "Something went wrong. Please try again.";
            }
        }
        catch
        {
            ServerError = "Could not connect. Please check your connection and try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }
}