{
  "BlazorAppUrl": "https://localhost:7219",
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/chatrooms",
    "MetadataAddress": "http://localhost:8080/realms/chatrooms/.well-known/openid-configuration",
    "ClientId": "chatrooms-bff"
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "X-Forwarded": "Set" }
        ]
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api": {
            "Address": "http://chatrooms-api"
          }
        }
      }
    }
  }
}