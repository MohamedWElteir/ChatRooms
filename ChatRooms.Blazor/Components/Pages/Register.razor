@page "/register"
@layout LandingLayout
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<Register> Logger

<PageTitle>Create account · ChatRooms</PageTitle>

<div class="auth-wrap">
    <div class="auth-card">

        <div class="auth-header">
            <p class="auth-brand">ChatRooms</p>
            <div class="auth-steps">
                <div class="auth-step @(_step >= 0 ? "active" : "") @(_step > 0 ? "done" : "")"></div>
                <div class="auth-step @(_step >= 1 ? "active" : "") @(_step > 1 ? "done" : "")"></div>
                <div class="auth-step @(_step >= 2 ? "active" : "")"></div>
            </div>
            <h1 class="auth-title">@_stepTitles[_step]</h1>
            <p class="auth-sub">@_stepSubs[_step]</p>
        </div>

        <div class="auth-body">
            @switch (_step)
            {
                case 0:
                    <AppInput Label="Display name"
                              Placeholder="e.g. JaneDoe"
                              Value="@_name"
                              ValueChanged="@(v => { _name = v; })"
                              Hint="No spaces · max 15 characters"
                              ErrorMessage="@_nameError" />

                    <AppInput Label="Email address"
                              Type="email"
                              Placeholder="you@example.com"
                              Value="@_email"
                              ValueChanged="@(v => { _email = v; })"
                              ErrorMessage="@_emailError" />
                    break;
                case 1:
                {
                    <AppInput Label="Password"
                              Type="password"
                              Placeholder="Min. 8 characters"
                              Value="@_password"
                              ValueChanged="@(v => { _password = v; ValidatePassword(); })" />

                    <div class="pw-strength">
                        <div class="pw-strength-bars">
                            @for (int i = 0; i < 4; i++)
                            {
                                var filled = i < _passwordScore;
                                var cls = filled ? $"pw-bar pw-bar--{_passwordClass}" : "pw-bar";
                                <div class="@cls"></div>
                            }
                        </div>
                        <span class="pw-strength-label">@_passwordLabel</span>
                    </div>

                    <AppInput Label="Confirm password"
                              Type="password"
                              Placeholder="Repeat your password"
                              Value="@_passwordConfirm"
                              ValueChanged="@(v => { _passwordConfirm = v; })"
                              ErrorMessage="@_passwordError" />
                    break;
                }
                case 2:
                    <div class="app-field">
                        <label class="app-field__label">Gender</label>
                        <div class="gender-grid">
                            <button class="gender-opt @(_gender == "Male" ? "gender-opt--selected" : "")"
                                    type="button" @onclick="@(() => _gender = "Male")">
                                Male
                            </button>
                            <button class="gender-opt @(_gender == "Female" ? "gender-opt--selected" : "")"
                                    type="button" @onclick="@(() => _gender = "Female")">
                                Female
                            </button>
                        </div>
                    </div>

                    <AppInput Label="Date of birth"
                              Type="date"
                              Value="@_birthDate"
                              ValueChanged="@(v => { _birthDate = v; })"
                              Hint="You must be at least 13 years old" />
                    break;
            }

            @if (!string.IsNullOrEmpty(_serverError))
            {
                <div class="auth-error">@_serverError</div>
            }
        </div>

        <div class="auth-footer">
            <AppButton Variant="primary"
                       FullWidth="true"
                       Loading="@_isLoading"
                       Disabled="@(!IsStepValid())"
                       OnClick="HandleNext">
                @(_step == 2 ? "Create account" : "Continue")
            </AppButton>

            @if (_step > 0)
            {
                <AppButton Variant="secondary"
                           FullWidth="true"
                           OnClick="@(() => _step--)">
                    Back
                </AppButton>
            }

            <p class="auth-signin-link">
                Already have an account?
                <a href="#" @onclick="@(() => Nav.NavigateTo($"{BffUrl}/bff/login", forceLoad: true))"
                   @onclick:preventDefault="false">Sign in</a>
            </p>
        </div>

    </div>
</div>

@code {
    private int _step;

    private string _name = "";
    private string _email = "";
    private string _password = "";
    private string _passwordConfirm = "";
    private string _gender = "";
    private string _birthDate = "";

    private readonly string _nameError = "";
    private readonly string _emailError = "";
    private readonly string _passwordError = "";
    private string _serverError = "";

    private int _passwordScore;
    private string _passwordClass = "";
    private string _passwordLabel = "Enter a password";

    private bool _isLoading;

    private string BffUrl
    {
        get
        {
            var cfg = Config["BffUrl"];
            if (!string.IsNullOrEmpty(cfg)) return cfg;

            var aspire = Config["services:chatrooms-bff:http:0"];
            return !string.IsNullOrEmpty(aspire) ? aspire : "http://localhost:5031";
        }
    }

    private readonly string[] _stepTitles = ["Create your account", "Secure your account", "A bit about you"];
    private readonly string[] _stepSubs =
    [
        "Start with your name and email.",
        "Choose a strong password.",
        "Almost done — just a couple more details."
    ];
    private HttpClient Http => HttpClientFactory.CreateClient("bff");
    private bool IsStepValid() => _step switch
    {
        0 => _name.Length is >= 2 and <= 15
             && !_name.Contains(' ')
             && _email.Contains('@') && _email.Contains('.'),

        1 => _password.Length >= 8
             && _password == _passwordConfirm
             && _passwordScore >= 2,

        2 => !string.IsNullOrEmpty(_gender)
             && !string.IsNullOrEmpty(_birthDate)
             && DateTime.TryParse(_birthDate, out var dob)
             && DateTime.UtcNow.Year - dob.Year >= 13,

        _ => false
    };

    private void ValidatePassword()
    {
        var p = _password;
        var score = 0;
        if (p.Length >= 8) score++;
        if (p.Any(char.IsUpper) && p.Any(char.IsLower)) score++;
        if (p.Any(char.IsDigit)) score++;
        if (p.Any(c => !char.IsLetterOrDigit(c))) score++;

        _passwordScore = score;
        (_passwordClass, _passwordLabel) = score switch
        {
            1 => ("weak", "Weak"),
            2 => ("fair", "Fair"),
            3 => ("good", "Good"),
            4 => ("strong", "Strong"),
            _ => ("", "Enter a password")
        };
    }

    private async Task HandleNext()
    {
        if (_step < 2) { _step++; return; }

        _isLoading = true;
        _serverError = "";

        try
        {
            var response = await Http.PostAsJsonAsync(
                "bff/register",
                new
                {
                    Name = _name,
                    Email = _email,
                    Password = _password,
                    Gender = _gender,
                    BirthDate = DateTime.Parse(_birthDate)
                });

            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo($"{BffUrl}/bff/login", forceLoad: true);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _serverError = (int)response.StatusCode switch
                {
                    >= 500 => "Our servers are having trouble. Please try again in a moment.",
                    409 => "An account with this email already exists.",
                    400 => "Please check your information and try again.",
                    _ => $"Unexpected error ({response.StatusCode}). Please try again."
                };
                Logger.LogWarning(
                    "Registration failed: {Status} {Body}", response.StatusCode, body);
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Registration connection failed");
            _serverError = "Could not reach the registration service. " +
                "Please make sure the application is running and try again.";
        }
        catch (TaskCanceledException)
        {
            Logger.LogWarning("Registration request timed out");
            _serverError = "The request took too long. Please check your connection and try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Registration failed unexpectedly");
            _serverError = "Something went wrong. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}